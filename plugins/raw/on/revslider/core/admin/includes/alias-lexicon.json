{
  "version": 2,
  "note": "Canonical alias -> role/weight lexicon in the LOCKED tagging vocabulary. Ships in SR7 core (revslider/admin/includes/alias-lexicon.json, admin-only, handed to the Quick Editor only when caps.slots); sr-connect readers point at that path once core has it. A rule outputs a role and, where the old vocab implied it, a weight. It is a low-confidence SUGGESTION only — the human confirms in Meta Editing.",
  "roles": [
    "headline",
    "subheadline",
    "body",
    "cta",
    "background",
    "product",
    "logo",
    "decoration"
  ],
  "weights": [
    "primary",
    "secondary",
    "decorative"
  ],
  "actions": [
    "text",
    "style",
    "media",
    "link",
    "hide",
    "addon",
    "preset"
  ],
  "statuses": [
    "todo",
    "checked",
    "metas",
    "bug",
    "ignore",
    "derived"
  ],
  "delivered": ["checked", "metas"],
  "normalize": "lowercase; strip digits and '#'; '-' and '_' -> space; collapse whitespace",
  "match": "first matching rule wins; a single-word pattern must match a WHOLE word; a multi-word pattern matches as a substring; a matched rule may also carry a weight suggestion",
  "gaps": "The old vocab's eyebrow and badge have no role in the locked 8: eyebrow-ish aliases (kicker/category/label/tag/overline) are mapped to subheadline, badge-ish (price/date/rating) to body. Change here if a label role is added.",
  "rules": [
